<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info><name>08_load_dim_publikacija</name><description>Popunjava denormalizovanu analitičku dimenziju publikacija.</description><extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory><parameters/><log><trans-log-table><connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/></trans-log-table><perf-log-table><connection/><schema/><table/><interval/><timeout_days/></perf-log-table><channel-log-table><connection/><schema/><table/><timeout_days/></channel-log-table><step-log-table><connection/><schema/><table/><timeout_days/></step-log-table><metrics-log-table><connection/><schema/><table/><interval/><timeout_days/></metrics-log-table></log><maxdate/><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies/><partitionschemas/><slaveservers/><clusterschemas/><created_user/><created_date/><modified_user/><modified_date/><key_for_session_key/><is_key_private>N</is_key_private></info>
  <connection><name>SEDS_OLTP</name><server>localhost</server><type>ORACLE</type><access>Native</access><database>/FREEPDB1</database><port>1521</port><username>SEDS_OLTP</username><password>SEDS_OLTP</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>1521</attribute></attribute></attributes></connection>
  <connection><name>SEDS_DW</name><server>localhost</server><type>ORACLE</type><access>Native</access><database>/FREEPDB1</database><port>1521</port><username>SEDS_DW</username><password>SEDS_DW</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>1521</attribute></attribute></attributes></connection>
  <order>
    <hop><from>Preuzmi i obogati publikacije</from><to>Dodaj konstantu nula</to><enabled>Y</enabled></hop>
    <hop><from>Dodaj konstantu nula</from><to>Popuni nedostajuće agregate</to><enabled>Y</enabled></hop>
    <hop><from>Popuni nedostajuće agregate</from><to>Odaberi analitičke atribute</to><enabled>Y</enabled></hop>
    <hop><from>Odaberi analitičke atribute</from><to>Učitaj DIM_PUBLIKACIJA</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Preuzmi i obogati publikacije</name><type>TableInput</type><description>Spaja publikaciju sa tipom, izdavačem i izračunatim brojem autora i primeraka.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>SEDS_OLTP</connection>
    <sql>SELECT p.publikacija_id AS PUBLIKACIJA_ID,
       p.naslov AS NASLOV,
       p.isbn AS ISBN,
       p.godina_izdanja AS GODINA_IZDANJA,
       p.broj_strana AS BROJ_STRANA,
       tp.naziv AS TIP_PUBLIKACIJE,
       i.naziv AS IZDAVAC,
       i.drzava AS DRZAVA_IZDAVACA,
       pa.broj_autora AS BROJ_AUTORA_IZVOR,
       pr.broj_primeraka AS BROJ_PRIMERAKA_IZVOR
  FROM publikacija p
  JOIN tip_publikacije tp ON tp.tip_publikacije_id = p.tip_publikacije_id
  JOIN izdavac i ON i.izdavac_id = p.izdavac_id
  LEFT JOIN (
    SELECT publikacija_id, COUNT(*) AS broj_autora
      FROM publikacija_autor
     GROUP BY publikacija_id
  ) pa ON pa.publikacija_id = p.publikacija_id
  LEFT JOIN (
    SELECT publikacija_id, COUNT(*) AS broj_primeraka
      FROM primerak
     GROUP BY publikacija_id
  ) pr ON pr.publikacija_id = p.publikacija_id</sql>
    <limit/><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>70</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Dodaj konstantu nula</name><type>Constant</type><description>Dodaje numeričku konstantu koja se koristi kao zamena za nedostajuće agregate.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><name>NULA</name><type>Number</type><format/><currency/><decimal/><group/><nullif>0</nullif><length>1</length><precision>0</precision><set_empty_string>N</set_empty_string></field></fields>
    <cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>350</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Popuni nedostajuće agregate</name><type>Calculator</type><description>Zamenjuje NULL vrednosti broja autora i primeraka nulom pomoću NVL operacije.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <calculation><field_name>BROJ_AUTORA</field_name><calc_type>NVL</calc_type><field_a>BROJ_AUTORA_IZVOR</field_a><field_b>NULA</field_b><field_c/><value_type>Number</value_type><value_length>4</value_length><value_precision>0</value_precision><remove>N</remove><conversion_mask/><decimal_symbol/><grouping_symbol/><currency_symbol/></calculation>
    <calculation><field_name>BROJ_PRIMERAKA</field_name><calc_type>NVL</calc_type><field_a>BROJ_PRIMERAKA_IZVOR</field_a><field_b>NULA</field_b><field_c/><value_type>Number</value_type><value_length>10</value_length><value_precision>0</value_precision><remove>N</remove><conversion_mask/><decimal_symbol/><grouping_symbol/><currency_symbol/></calculation>
    <cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>610</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Odaberi analitičke atribute</name><type>SelectValues</type><description>Uklanja pomoćna polja i zadržava atribute definisane šemom dimenzije.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><name>PUBLIKACIJA_ID</name></field><field><name>NASLOV</name></field><field><name>ISBN</name></field><field><name>GODINA_IZDANJA</name></field><field><name>BROJ_STRANA</name></field><field><name>TIP_PUBLIKACIJE</name></field><field><name>IZDAVAC</name></field><field><name>DRZAVA_IZDAVACA</name></field><field><name>BROJ_AUTORA</name></field><field><name>BROJ_PRIMERAKA</name></field><select_unspecified>N</select_unspecified></fields>
    <cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>870</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Učitaj DIM_PUBLIKACIJA</name><type>TableOutput</type><description>Upisuje obogaćenu dimenziju publikacija.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>SEDS_DW</connection><schema/><table>DIM_PUBLIKACIJA</table><commit>5000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>N</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>N</tablename_in_table><return_keys>N</return_keys><return_field/>
    <fields><field><column_name>PUBLIKACIJA_ID</column_name><stream_name>PUBLIKACIJA_ID</stream_name></field><field><column_name>NASLOV</column_name><stream_name>NASLOV</stream_name></field><field><column_name>ISBN</column_name><stream_name>ISBN</stream_name></field><field><column_name>GODINA_IZDANJA</column_name><stream_name>GODINA_IZDANJA</stream_name></field><field><column_name>BROJ_STRANA</column_name><stream_name>BROJ_STRANA</stream_name></field><field><column_name>TIP_PUBLIKACIJE</column_name><stream_name>TIP_PUBLIKACIJE</stream_name></field><field><column_name>IZDAVAC</column_name><stream_name>IZDAVAC</stream_name></field><field><column_name>DRZAVA_IZDAVACA</column_name><stream_name>DRZAVA_IZDAVACA</stream_name></field><field><column_name>BROJ_AUTORA</column_name><stream_name>BROJ_AUTORA</stream_name></field><field><column_name>BROJ_PRIMERAKA</column_name><stream_name>BROJ_PRIMERAKA</stream_name></field></fields>
    <attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>1180</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/><slave-step-copy-partition-distribution/><slave_transformation>N</slave_transformation><attributes/>
</transformation>
