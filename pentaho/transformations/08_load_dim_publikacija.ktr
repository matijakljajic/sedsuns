<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info><name>08_load_dim_publikacija</name><description>Loads publications with denormalized analytical attributes.</description><extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory><parameters></parameters><log><trans-log-table><connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/></trans-log-table><perf-log-table><connection/><schema/><table/><interval/><timeout_days/></perf-log-table><channel-log-table><connection/><schema/><table/><timeout_days/></channel-log-table><step-log-table><connection/><schema/><table/><timeout_days/></step-log-table><metrics-log-table><connection/><schema/><table/><timeout_days/></metrics-log-table></log><maxdate/><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user/><created_date/><modified_user/><modified_date/><key_for_session_key/><is_key_private>N</is_key_private></info>
  <connection><name>SEDS_OLTP</name><server>localhost</server><type>ORACLE</type><access>Native</access><database>/FREEPDB1</database><port>1521</port><username>SEDS_OLTP</username><password>SEDS_OLTP</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>1521</attribute></attribute></attributes></connection>
  <connection><name>SEDS_DW</name><server>localhost</server><type>ORACLE</type><access>Native</access><database>/FREEPDB1</database><port>1521</port><username>SEDS_DW</username><password>SEDS_DW</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>1521</attribute></attribute></attributes></connection>
  <order><hop><from>Extract and enrich PUBLIKACIJA</from><to>Load DIM_PUBLIKACIJA</to><enabled>Y</enabled></hop></order>
  <step><name>Extract and enrich PUBLIKACIJA</name><type>TableInput</type><description>Joins publication lookups and calculates author/copy counts.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>SEDS_OLTP</connection><sql>SELECT p.publikacija_id AS PUBLIKACIJA_ID,
       p.naslov AS NASLOV,
       p.isbn AS ISBN,
       p.godina_izdanja AS GODINA_IZDANJA,
       p.broj_strana AS BROJ_STRANA,
       tp.naziv AS TIP_PUBLIKACIJE,
       i.naziv AS IZDAVAC,
       i.drzava AS DRZAVA_IZDAVACA,
       NVL(pa.broj_autora, 0) AS BROJ_AUTORA,
       NVL(pr.broj_primeraka, 0) AS BROJ_PRIMERAKA
  FROM publikacija p
  JOIN tip_publikacije tp ON tp.tip_publikacije_id = p.tip_publikacije_id
  JOIN izdavac i ON i.izdavac_id = p.izdavac_id
  LEFT JOIN (
    SELECT publikacija_id, COUNT(*) AS broj_autora
      FROM publikacija_autor
     GROUP BY publikacija_id
  ) pa ON pa.publikacija_id = p.publikacija_id
  LEFT JOIN (
    SELECT publikacija_id, COUNT(*) AS broj_primeraka
      FROM primerak
     GROUP BY publikacija_id
  ) pr ON pr.publikacija_id = p.publikacija_id</sql><limit/><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>120</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>
  <step><name>Load DIM_PUBLIKACIJA</name><type>TableOutput</type><description>Loads the enriched publication dimension.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>SEDS_DW</connection><schema/><table>DIM_PUBLIKACIJA</table><commit>5000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>N</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>N</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>PUBLIKACIJA_ID</column_name><stream_name>PUBLIKACIJA_ID</stream_name></field><field><column_name>NASLOV</column_name><stream_name>NASLOV</stream_name></field><field><column_name>ISBN</column_name><stream_name>ISBN</stream_name></field><field><column_name>GODINA_IZDANJA</column_name><stream_name>GODINA_IZDANJA</stream_name></field><field><column_name>BROJ_STRANA</column_name><stream_name>BROJ_STRANA</stream_name></field><field><column_name>TIP_PUBLIKACIJE</column_name><stream_name>TIP_PUBLIKACIJE</stream_name></field><field><column_name>IZDAVAC</column_name><stream_name>IZDAVAC</stream_name></field><field><column_name>DRZAVA_IZDAVACA</column_name><stream_name>DRZAVA_IZDAVACA</stream_name></field><field><column_name>BROJ_AUTORA</column_name><stream_name>BROJ_AUTORA</stream_name></field><field><column_name>BROJ_PRIMERAKA</column_name><stream_name>BROJ_PRIMERAKA</stream_name></field></fields><attributes/><cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>550</xloc><yloc>160</yloc><draw>Y</draw></GUI></step>
  <step_error_handling></step_error_handling><slave-step-copy-partition-distribution></slave-step-copy-partition-distribution><slave_transformation>N</slave_transformation><attributes/>
</transformation>
