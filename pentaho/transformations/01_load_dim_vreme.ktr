<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>01_load_dim_vreme</name>
    <description>Popunjava vremensku dimenziju sa tri uloge iz datuma OLTP pozajmica.</description>
    <extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory><parameters/>
    <log>
      <trans-log-table><connection/><schema/><table/><size_limit_lines/><interval/><timeout_days/></trans-log-table>
      <perf-log-table><connection/><schema/><table/><interval/><timeout_days/></perf-log-table>
      <channel-log-table><connection/><schema/><table/><timeout_days/></channel-log-table>
      <step-log-table><connection/><schema/><table/><timeout_days/></step-log-table>
      <metrics-log-table><connection/><schema/><table/><interval/><timeout_days/></metrics-log-table>
    </log>
    <maxdate/><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies/><partitionschemas/><slaveservers/><clusterschemas/><created_user/><created_date/><modified_user/><modified_date/><key_for_session_key/><is_key_private>N</is_key_private>
  </info>
  <connection><name>SEDS_OLTP</name><server>localhost</server><type>ORACLE</type><access>Native</access><database>/FREEPDB1</database><port>1521</port><username>SEDS_OLTP</username><password>SEDS_OLTP</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>1521</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes></connection>
  <connection><name>SEDS_DW</name><server>localhost</server><type>ORACLE</type><access>Native</access><database>/FREEPDB1</database><port>1521</port><username>SEDS_DW</username><password>SEDS_DW</password><servername/><data_tablespace/><index_tablespace/><attributes><attribute><code>PORT_NUMBER</code><attribute>1521</attribute></attribute><attribute><code>USE_POOLING</code><attribute>N</attribute></attribute></attributes></connection>
  <order>
    <hop><from>Preuzmi različite datume</from><to>Izračunaj kalendarske atribute</to><enabled>Y</enabled></hop>
    <hop><from>Izračunaj kalendarske atribute</from><to>Odaberi atribute dimenzije</to><enabled>Y</enabled></hop>
    <hop><from>Odaberi atribute dimenzije</from><to>Učitaj DIM_VREME</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Preuzmi različite datume</name><type>TableInput</type><description>Izvlači svaki različit datum pozajmice, roka ili vraćanja.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>SEDS_OLTP</connection>
    <sql>SELECT datum AS DATUM
  FROM (
    SELECT datum_pozajmice AS datum FROM pozajmica
    UNION
    SELECT rok_vracanja AS datum FROM pozajmica
    UNION
    SELECT datum_vracanja AS datum FROM pozajmica WHERE datum_vracanja IS NOT NULL
  )</sql>
    <limit/><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>80</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Izračunaj kalendarske atribute</name><type>ScriptValueMod</type><description>Formira ključ datuma i kalendarske atribute potrebne za analizu.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><compatible>N</compatible><optimizationLevel>9</optimizationLevel>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Kalendarski atributi</jsScript_name><jsScript_script><![CDATA[
var VREME_ID = Number(date2str(DATUM, "yyyyMMdd"));
var DAN = Number(date2str(DATUM, "dd"));
var MESEC = Number(date2str(DATUM, "MM"));
var GODINA = Number(date2str(DATUM, "yyyy"));
var KVARTAL = Math.floor((MESEC - 1) / 3) + 1;
var nazivi_meseca = ["januar", "februar", "mart", "april", "maj", "jun", "jul", "avgust", "septembar", "oktobar", "novembar", "decembar"];
var nazivi_dana = ["nedelja", "ponedeljak", "utorak", "sreda", "četvrtak", "petak", "subota"];
var NAZIV_MESECA = nazivi_meseca[MESEC - 1];
var DAN_U_NEDELJI = nazivi_dana[DATUM.getDay()];
]]></jsScript_script></jsScript></jsScripts>
    <fields>
      <field><name>VREME_ID</name><rename>VREME_ID</rename><type>Integer</type><length>8</length><precision>0</precision><replace>N</replace></field>
      <field><name>DAN</name><rename>DAN</rename><type>Integer</type><length>2</length><precision>0</precision><replace>N</replace></field>
      <field><name>MESEC</name><rename>MESEC</rename><type>Integer</type><length>2</length><precision>0</precision><replace>N</replace></field>
      <field><name>NAZIV_MESECA</name><rename>NAZIV_MESECA</rename><type>String</type><length>20</length><precision>-1</precision><replace>N</replace></field>
      <field><name>KVARTAL</name><rename>KVARTAL</rename><type>Integer</type><length>1</length><precision>0</precision><replace>N</replace></field>
      <field><name>GODINA</name><rename>GODINA</rename><type>Integer</type><length>4</length><precision>0</precision><replace>N</replace></field>
      <field><name>DAN_U_NEDELJI</name><rename>DAN_U_NEDELJI</rename><type>String</type><length>20</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>330</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Odaberi atribute dimenzije</name><type>SelectValues</type><description>Zadržava samo polja definisana šemom DIM_VREME.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><name>VREME_ID</name></field><field><name>DATUM</name></field><field><name>DAN</name></field><field><name>MESEC</name></field><field><name>NAZIV_MESECA</name></field><field><name>KVARTAL</name></field><field><name>GODINA</name></field><field><name>DAN_U_NEDELJI</name></field><select_unspecified>N</select_unspecified></fields>
    <cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>610</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Učitaj DIM_VREME</name><type>TableOutput</type><description>Upisuje vremensku dimenziju u DW.</description><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning><connection>SEDS_DW</connection><schema/><table>DIM_VREME</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>N</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>N</tablename_in_table><return_keys>N</return_keys><return_field/>
    <fields><field><column_name>VREME_ID</column_name><stream_name>VREME_ID</stream_name></field><field><column_name>DATUM</column_name><stream_name>DATUM</stream_name></field><field><column_name>DAN</column_name><stream_name>DAN</stream_name></field><field><column_name>MESEC</column_name><stream_name>MESEC</stream_name></field><field><column_name>NAZIV_MESECA</column_name><stream_name>NAZIV_MESECA</stream_name></field><field><column_name>KVARTAL</column_name><stream_name>KVARTAL</stream_name></field><field><column_name>GODINA</column_name><stream_name>GODINA</stream_name></field><field><column_name>DAN_U_NEDELJI</column_name><stream_name>DAN_U_NEDELJI</stream_name></field></fields>
    <attributes/><cluster_schema/><remotesteps><input/><output/></remotesteps><GUI><xloc>900</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/><slave-step-copy-partition-distribution/><slave_transformation>N</slave_transformation><attributes/>
</transformation>
