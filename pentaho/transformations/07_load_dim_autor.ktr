<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>07_load_dim_autor</name>
    <description>Popunjava dimenziju autora.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters/>
    <log>
      <trans-log-table>
        <connection/>
        <schema/>
        <table/>
        <size_limit_lines/>
        <interval/>
        <timeout_days/>
      </trans-log-table>
      <perf-log-table>
        <connection/>
        <schema/>
        <table/>
        <interval/>
        <timeout_days/>
      </perf-log-table>
      <channel-log-table>
        <connection/>
        <schema/>
        <table/>
        <timeout_days/>
      </channel-log-table>
      <step-log-table>
        <connection/>
        <schema/>
        <table/>
        <timeout_days/>
      </step-log-table>
      <metrics-log-table>
        <connection/>
        <schema/>
        <table/>
        <timeout_days/>
      </metrics-log-table>
    </log>
    <maxdate/>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies/>
    <partitionschemas/>
    <slaveservers/>
    <clusterschemas/>
    <created_user/>
    <created_date/>
    <modified_user/>
    <modified_date/>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <connection>
    <name>SEDS_OLTP</name>
    <server>localhost</server>
    <type>ORACLE</type>
    <access>Native</access>
    <database>/FREEPDB1</database>
    <port>1521</port>
    <username>SEDS_OLTP</username>
    <password>SEDS_OLTP</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>1521</attribute>
      </attribute>
    </attributes>
  </connection>
  <connection>
    <name>SEDS_DW</name>
    <server>localhost</server>
    <type>ORACLE</type>
    <access>Native</access>
    <database>/FREEPDB1</database>
    <port>1521</port>
    <username>SEDS_DW</username>
    <password>SEDS_DW</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute>
        <code>PORT_NUMBER</code>
        <attribute>1521</attribute>
      </attribute>
    </attributes>
  </connection>
  <order>
    <hop>
      <from>Preuzmi AUTOR</from>
      <to>Učitaj DIM_AUTOR</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Preuzmi AUTOR</name>
    <type>TableInput</type>
    <description>Preuzima atribute autora, uključujući opciono prezime.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>SEDS_OLTP</connection>
    <sql>SELECT autor_id AS AUTOR_ID,
       ime AS IME,
       prezime AS PREZIME,
       godina_rodjenja AS GODINA_RODJENJA,
       drzava AS DRZAVA
  FROM autor</sql>
    <limit/>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Učitaj DIM_AUTOR</name>
    <type>TableOutput</type>
    <description>Upisuje dimenziju autora u DW.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>SEDS_DW</connection>
    <schema/>
    <table>DIM_AUTOR</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>AUTOR_ID</column_name>
        <stream_name>AUTOR_ID</stream_name>
      </field>
      <field>
        <column_name>IME</column_name>
        <stream_name>IME</stream_name>
      </field>
      <field>
        <column_name>PREZIME</column_name>
        <stream_name>PREZIME</stream_name>
      </field>
      <field>
        <column_name>GODINA_RODJENJA</column_name>
        <stream_name>GODINA_RODJENJA</stream_name>
      </field>
      <field>
        <column_name>DRZAVA</column_name>
        <stream_name>DRZAVA</stream_name>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>500</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
